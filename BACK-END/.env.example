# URL do seu projeto no Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima pública do Supabase (Project Settings > API > anon public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço do Supabase (Project Settings > API > service_role)
# ATENÇÃO: Nunca exponha esta chave no frontend!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ambiente da aplicação (development | production)
APP_ENV=development

#Chave anônima da api do gemini
GEMINI_API_KEY=AIzaSyB_mOzXrqxoh-hl5-Gh6etbIz3Wl2Y9jEc

# Origens CORS autorizadas (CSV). Ex: http://localhost:8081,exp://192.168.1.12:8081
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.12:8081